# 14-container-docker: cgpipe.container.engine = "docker" + job.container wraps the
# rendered body with a `docker run ... bash $body` invocation. The wd, input and output
# directories, and /tmp (body_dir) are auto-mounted.

cgpipe.container.engine = "docker"
job.container = "alpine:latest"

output.txt:
    echo "hello container" > output.txt
