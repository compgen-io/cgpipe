#!/bin/bash
#BATCHQ -name cgjob_output.txt
#BATCHQ -output output.txt
#BATCHQ -wd .
set -eo pipefail
__cgpipe_body=$(mktemp "/cgpipe-bodydir/cgpipe-body.XXXXXX")
trap 'rm -f "$__cgpipe_body"' EXIT
cat > "$__cgpipe_body" <<'__CGPIPE_BODY__'
nvidia-smi > output.txt
__CGPIPE_BODY__

docker run --rm \
    -v /cgpipe-test:/cgpipe-test \
    -v /cgpipe-bodydir:/cgpipe-bodydir \
    -w /cgpipe-test \
    -u $(id -u):$(id -g) \
    --gpus all \
    nvidia/cuda:12.0-base \
    sh "$__cgpipe_body"

