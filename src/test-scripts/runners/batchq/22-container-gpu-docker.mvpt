# 22-container-gpu-docker: docker container + `job.gpu = 1` produces `--gpus all`
# (the convenience mapping — "give me a GPU, you pick which").

cgpipe.container.engine = "docker"
cgpipe.container.body_dir = "/cgpipe-bodydir"
job.container = "nvidia/cuda:12.0-base"

output.txt:
    <%
        job.gpu = 1
    %>
    nvidia-smi > output.txt
