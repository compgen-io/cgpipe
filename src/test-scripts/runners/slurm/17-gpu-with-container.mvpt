# 17-gpu-with-container: the unified `job.gpu` setting drives BOTH the SLURM
# directive block AND the docker container wrapping. This is the headline test
# for the cross-layer unification.

cgpipe.container.engine = "docker"
cgpipe.container.body_dir = "/cgpipe-bodydir"
job.container = "nvidia/cuda:12.0-base"

output.txt:
    <%
        job.gpu = 2
    %>
    nvidia-smi > output.txt
