#!${job.shell}
#BATCHQ -name ${job.name}
<% if cgpipe.run_id %>
#BATCHQ -run-id ${cgpipe.run_id}
<% endif %>
<% if job.hold %>
#BATCHQ -hold
<% endif %>
<% 
job.procs ?= 1
if job.procs > 1 %>
#BATCHQ -procs ${job.procs}
<% endif %>
<% if job.mem %>
#BATCHQ -mem ${job.mem}
<% endif %>
<% if job.walltime %>
#BATCHQ -walltime ${job.walltime}
<% endif %>
<% if job.batchq.depids %>
#BATCHQ -afterok ${job.batchq.depids}
<% endif %>
<% if job.mail %>
#BATCHQ -mail ${job.mail}
<% endif %>
<% if job.stdout %>
#BATCHQ -stdout ${job.stdout}
<% endif %>
<% if job.stderr %>
#BATCHQ -stderr ${job.stderr}
<% endif %>
<% for input in job._inputs %>
<% if input %>
#BATCHQ -input ${input}
<% endif %>
<% done %>
<% for output in job._outputs %>
<% if output %>
#BATCHQ -output ${output}
<% endif %>
<% done %>
<% for custom in job.custom %>
<% if custom %>
#BATCHQ ${custom}
<% endif %>
<% done %>
#BATCHQ -wd .
<% if job.env %>
#BATCHQ -env
<% endif %>

set -eo pipefail

<% for line in job.setup %>
<% if line %>
${line}
<% endif %>
<% done %>

${job._body}
